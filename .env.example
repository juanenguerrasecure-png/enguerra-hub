# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# Enguerra of NY Server-Side Environment Variables
# Stored securely server-side in AI Studio / Cloud Run secrets manager.
# NEVER expose to browser.
# ==============================================================================

# Central Google Sheets database spreadsheet ID
ENGUERRA_SHEET_ID="your_google_sheet_id_here"

# Central Google Drive root folder ID for private media storage
ENGUERRA_DRIVE_ROOT_FOLDER_ID="your_drive_root_folder_id_here"

# Google OAuth 2.0 Credentials (for server-to-Google access)
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_REFRESH_TOKEN="your_google_refresh_token_here"

# Optional: Service account private key JSON (alternative for Workspace Shared Drives)
GOOGLE_SERVICE_ACCOUNT_KEY=""

# Application Session Secret (used to sign session tokens securely)
APP_SESSION_SECRET="generate_a_secure_random_string_32_bytes_or_more"

# Deployment Environment: "DEV" | "QA" | "PROD" (Default: "DEV")
ENGUERRA_ENV="DEV"
